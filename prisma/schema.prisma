generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Interview {
  id        String      @id
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}

model Problem {
  id         String    @id 
  title      String
  difficulty String
  topic      String
  description String
  functionName String
  parameters String[]
  execution Json
  examples Json
  constraints Json
  testCases Json
  hiddenTestCases Json
}
